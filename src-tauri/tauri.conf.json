{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Java Desktop",
  "version": "0.2.2",
  "identifier": "net.linlan.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DSH Java Desktop",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "devtools": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "resources": {
      "../resources/agent/dsh-java-app.jar": "agent/dsh-java-app.jar",
      "../resources/agent/runtime": "agent/runtime"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwOTgxMzVBMDk4RkVBQjMKUldTejZvOEpXaE9Zd0V4M01IQkZVazRJVG5MclMzYlRUL3pKQ1IwclNsQ25VZ2pyeFV0UTk3OEYK",
      "endpoints": [
        "https://github.com/linlannet/dsh-java-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}